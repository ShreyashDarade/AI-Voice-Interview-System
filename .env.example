# Copy to .env (backend/.env or repo root). Everything has a safe default for local development.

# --- core ------------------------------------------------------------------------
# python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
ENVIRONMENT=development            # development | staging | production (production refuses to start without SECRET_KEY)
DEBUG=true                         # MUST be false in production (enables HTTPS redirect + HSTS + API-key requirement)
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TRUST_PROXY_SSL_HEADER=false       # true behind a TLS-terminating proxy that sets X-Forwarded-Proto
LOG_LEVEL=INFO

# --- infrastructure (unset => SQLite + in-memory channel layer; fine for one dev process only) --
DATABASE_URL=                      # postgres://user:pass@host:5432/db
REDIS_URL=                         # redis://host:6379/0   (required for more than one worker)

# --- voice: Gemini Live ----------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-native-audio-preview-12-2025   # verify the current Live model id in Google's docs
GEMINI_VOICE_NAME=Aoede
GEMINI_CONNECTION_TIMEOUT=30
GEMINI_MAX_RETRIES=3
GEMINI_RETRY_DELAY=2.0

# --- proctoring ------------------------------------------------------------------
PROCTOR_MODEL_DIR=                 # default backend/models ; run: python manage.py fetch_proctor_models
PROCTOR_POOL_SIZE=2                # model instances per process (each handles one frame at a time)
PROCTOR_ENABLE_OBJECTS=true        # phone / book / extra-person detection
PROCTOR_ENABLE_IDENTITY=true       # face-embedding identity continuity
PROCTOR_DEFAULT_POLICY=standard    # lenient | standard | strict
PROCTOR_REQUIRE_API_KEY=           # default: true unless DEBUG
PROCTOR_TOKEN_SECRET=              # default: SECRET_KEY (rotate => outstanding candidate tokens die)
PROCTOR_TOKEN_TTL_S=14400
PROCTOR_MAX_FRAME_BYTES=300000
PROCTOR_MAX_FRAME_RATE_HZ=6
PROCTOR_EVIDENCE_RETENTION_DAYS=30
PROCTOR_SESSION_RETENTION_DAYS=90
PROCTOR_CONSENT_VERSION=2026-10
PROCTOR_WEBHOOK_TIMEOUT_S=8
PROCTOR_WEBHOOK_MAX_ATTEMPTS=8
MAX_CONCURRENT_INTERVIEWS=50       # websocket capacity per process

# --- audio front-end -------------------------------------------------------------
VAD_ENERGY_THRESHOLD=0.025
VAD_ZCR_THRESHOLD=0.15
VAD_SPEECH_FRAMES=5
VAD_SILENCE_FRAMES=12
MAX_AUDIO_CHUNK_SIZE_KB=256

# --- uploads ---------------------------------------------------------------------
MAX_RESUME_SIZE_MB=10

# --- optional LLM (text only: question tailoring, transcript evaluation, resume enrichment) --------
# Never used for video/proctoring. Off unless a provider is configured. Candidate text is redacted
# (email/phone/URLs) before it is sent. Use OLLAMA for fully local processing.
LLM_ENABLED=true                   # kill switch
LLM_PROVIDER=                      # anthropic | openai | ollama | none  (auto-detected from the keys below)
LLM_MODEL=                         # required for openai/ollama; anthropic defaults to claude-sonnet-5-5
LLM_TIMEOUT_S=60
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=                   # any OpenAI-compatible server (vLLM, LM Studio, ...)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=
